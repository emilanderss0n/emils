---
import { Image } from 'astro:assets';
import type { ComponentProps } from 'astro/types';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon, { type IconName } from '@components/Icon.astro';
import ProjectRow from '@components/ProjectRow.astro';
import MoreItem from '@components/MoreItem.astro';
import { featured, getGithubStats, getRepoInfo, githubProfile } from '@lib/github';
import { codepenProfile } from '@lib/codepen';
import { getMoreItems } from '@lib/more-projects';

import portrait from '@assets/img/emil.webp';

const github = await getGithubStats();
const moreItems = await getMoreItems();

// All figures update on each build. Years count from 2009, when I started my first
// agency; the rest comes from GitHub (see the repos loader in content/config.ts).
// Big numbers round down to a stable "870K" instead of changing with every download.
const roundDown = (n: number) =>
  n >= 10_000 ? `${Math.floor(n / 10_000) * 10}K` : n >= 1_000 ? `${Math.floor(n / 1_000)}K` : String(n);
const stats = [
  { label: 'Building for the web', figure: String(new Date().getFullYear() - 2009), unit: 'years' },
  { label: 'Mods and tools downloaded', figure: roundDown(github.downloads), unit: 'times' },
  { label: 'Versions shipped on GitHub', figure: String(github.releases), unit: 'releases' },
  { label: 'Open source on GitHub', figure: String(github.repos), unit: 'repos' },
];
// Each row links to its GitHub repo and shows its stars, both read from GitHub at build
// time; `href` here is only a fallback for when GitHub can't be reached.
const featuredProjects = [
  {
    repo: featured.nhlplay,
    title: 'NHLPLAY',
    tags: ['Web app', 'UI Design'],
    text: 'For hockey fans who want more than box scores. Follow games live, dig into player stats, track your favourite players and build your dream lineup with drag and drop.',
    specs: [['Year', '2025'], ['Stack', 'PHP, JavaScript, CSS'], ['Data', 'NHL API']],
    href: 'https://github.com/emilanderss0n/nhlplay-feedback',
    extra: { label: 'Feedback', href: 'https://github.com/emilanderss0n/nhlplay-feedback/issues' },
  },
  {
    repo: featured.tarkynator,
    title: 'Tarkynator',
    tags: ['Web tool', 'Graphic Design'],
    text: 'The quick way to look things up in Single Player Tarkov. Items, quests, crafts and traders in one fast search, pulled live from the Tarkov API.',
    specs: [['Year', '2024'], ['Stack', 'JavaScript, CSS, HTML'], ['Data', 'Tarkov API']],
    href: 'https://github.com/emilanderss0n/tarkynator',
  },
  {
    repo: featured.menuOverhaul,
    title: 'Menu Overhaul',
    tags: ['Game mod', 'UI Design'],
    text: 'A full redesign of the menus in Escape from Tarkov. Every screen gets a new look and feel, from the main menu to the character and trader screens.',
    specs: [['Year', '2024'], ['Stack', 'C#, Unity'], ['Tools', 'Photoshop, Visual Studio']],
    href: 'https://github.com/emilanderss0n/SPT-Menu-Overhaul',
  },
] satisfies (Omit<ComponentProps<typeof ProjectRow>, 'index'> & { repo: string })[];

const projects = await Promise.all(
  featuredProjects.map(async ({ repo, ...project }) => {
    const info = await getRepoInfo(repo);
    return { ...project, href: info.url ?? project.href, stars: info.stars };
  }),
);

const services = [
  { name: 'UI Design', icon: 'pen-tool', text: 'Interfaces that make complicated things feel simple, from a single menu to a whole app.' },
  { name: 'Web Development', icon: 'code', text: 'Fast, responsive websites and web apps, built around your content and the people who use them.' },
  { name: '3D Art', icon: 'box', text: 'Models, textures and game-ready assets, from one hero item to a set of seventy.' },
  { name: 'Video Editing', icon: 'clapperboard', text: 'Tight edits, motion and sound design that give your story pace and polish.' },
] satisfies { name: string; icon: IconName; text: string }[];

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout overHero>
  <section class="hero" aria-labelledby="hero-title" data-intro>
    <canvas class="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-chip enter"><span class="status-dot" aria-hidden="true"></span>Available for new projects</p>
        <h1 class="hero-title scramble" id="hero-title" data-scramble-delay="120" data-scramble-speed="1.1">
          <span class="visually-hidden">Designer &amp; developer building tools, mods and worlds.</span>
          <span class="scramble-seg" data-text="Designer & developer" aria-hidden="true">Designer &amp; developer</span>
          <span class="hero-gradient" aria-hidden="true"><span class="scramble-seg" data-text="building tools, mods and ">building tools, mods and </span><em class="scramble-seg" data-text="worlds.">worlds.</em></span>
        </h1>
        <p class="hero-lede enter">I'm Emil, also known as Moxo. I design interfaces, build for the web, make 3D art and edit video. Open to freelance work, or to joining a creative team.</p>
      </div>
      <div class="hero-meta enter">
        <p>UI · Web · 3D · Video</p>
        <p>Based in Tranås, Sweden</p>
        <a class="hero-scroll" href="#work">Scroll<Icon name="arrow-down" /></a>
      </div>
    </div>
  </section>

  <section class="facts wrap" aria-label="In numbers">
    <dl class="stats">
      {stats.map((stat) => (
        <div class="stat" data-reveal="contents">
          <dt>{stat.label}</dt>
          <dd>
            <span class="stat-figure scramble" data-scramble-trigger="reveal" data-scramble-delay="80" aria-hidden="true"><span class="scramble-seg" data-text={stat.figure}>{stat.figure}</span></span>
            <span class="visually-hidden">{stat.figure}</span>
            <span class="stat-unit">{stat.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section wrap" id="work" aria-labelledby="work-title">
    <div class="section-top">
      <p class="eyebrow" data-reveal>Selected work<span class="eyebrow-count">{pad(projects.length + moreItems.length)}</span></p>
      <div class="section-head">
        <h2 class="section-title" id="work-title" data-reveal>Apps, tools and mods <span>used by thousands of people.</span></h2>
        <p class="section-lede" data-reveal>From a live companion app for NHL fans to tools, menus and custom items for the Single Player Tarkov community. I take every project from the first sketch to the shipped build, and handle the design, the code and the 3D art myself.</p>
      </div>
    </div>

    <ol class="projects frame" role="list">
      {projects.map((project, i) => <ProjectRow index={pad(i + 1)} {...project} />)}
    </ol>

    {moreItems.length > 0 && (
      <div class="more">
        <div class="more-head" data-reveal>
          <h3 class="more-title">More projects</h3>
          <p class="more-links">
            <a class="link" href={githubProfile} target="_blank" rel="noopener">GitHub<Icon name="external" /></a>
            <a class="link" href={codepenProfile} target="_blank" rel="noopener">CodePen<Icon name="external" /></a>
          </p>
        </div>
        <ul class="more-list frame" role="list">
          {moreItems.map((item) => <MoreItem item={item} />)}
        </ul>
      </div>
    )}
  </section>

  <section class="section wrap" id="services" aria-labelledby="services-title">
    <div class="section-top">
      <p class="eyebrow" data-reveal>Services<span class="eyebrow-count">{pad(services.length)}</span></p>
      <div class="services-head">
        <h2 class="section-title" id="services-title" data-reveal>What I can do <span>for your next project.</span></h2>
        <p class="section-lede" data-reveal>A generalist on purpose. One person carrying an idea from the first sketch to the shipped build means nothing gets lost between design and code. <a class="link link-inline" href="#contact">Let's discuss your project<Icon name="arrow-right" /></a></p>
      </div>
    </div>
    <ol class="services" role="list">
      {services.map((service) => (
        <li class="service" data-reveal>
          <Icon name={service.icon} />
          <h3 class="service-name">{service.name}</h3>
          <p class="service-text">{service.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap" id="about" aria-labelledby="about-title">
    <p class="eyebrow" data-reveal>About</p>
    <div class="split">
      <div class="split-aside">
        <h2 class="section-title" id="about-title" data-reveal>Hi, I'm Emil. <span>A creative generalist from Sweden.</span></h2>
        <figure class="about-portrait">
          <Image src={portrait} alt="Portrait of Emil Andersson" widths={[400, 800]} sizes="(max-width: 47.5rem) 18rem, 22rem" loading="lazy" />
        </figure>
      </div>
      <div class="about">
        <blockquote class="about-quote" data-reveal>
          <p>“Sometimes you help people with your creations <span>without even realising it.”</span></p>
        </blockquote>
        <div class="prose" data-reveal>
          <p>I was born in 1989 in Skänninge, a small town in Sweden, and I've been making things for as long as I can remember. These days I live in Tranås, and writing code or making art is still how I'd rather spend my day.</p>
          <p>At 20, a friend and I started our own agency, Delive – Web Solutions, and some of the brands we made for those first clients are still around today. Later I moved into 3D art and game development, and I've since worked with people all over the world on websites, tools and games.</p>
        </div>
        <dl class="specs specs-wide" data-reveal>
          <div><dt>Based in</dt><dd>Tranås, Sweden</dd></div>
          <div><dt>Roles</dt><dd>UI designer, web developer, 3D artist, video editor</dd></div>
          <div><dt>Toolset</dt><dd>Blender, Photoshop, Substance Painter, Unity, VS Code</dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHeroAura } from '@scripts/hero-aura';
  import { initScramble } from '@scripts/text-scramble';
  import { initPointerGlow } from '@scripts/pointer-glow';

  initHeroAura();
  initPointerGlow();
  // Wait for web fonts so the reserved space matches the final text. The headline
  // starts the hero's intro; the chip, intro text and labels follow on their delays.
  void document.fonts.ready.then(() => {
    document.querySelector('.hero')?.setAttribute('data-play', '');
    initScramble();
  });
</script>

---
// ProjectRow.astro — featured project as a large row in the .projects list.
// The whole row links to the project's GitHub repo; an optional extra link
// (e.g. NHLPLAY's feedback page) sits above that link.
import Icon from '@components/Icon.astro';

interface Props {
  index: string;
  title: string;
  tags: string[];
  text: string;
  specs: [label: string, value: string][];
  href: string;
  stars?: number;
  extra?: { label: string; href: string };
}

const { index, title, tags, text, specs, href, stars = 0, extra } = Astro.props;
---

<li class="project" data-glow data-reveal="contents">
  <span class="project-index">{index}</span>
  <div class="project-main">
    <p class="project-tags">
      {tags.join(' / ')}
      {stars > 0 && <span class="project-stars"><span aria-hidden="true">/</span><Icon name="star" />{stars}<span class="visually-hidden">{stars === 1 ? ' star' : ' stars'}</span></span>}
    </p>
    <h3 class="project-title">
      <a class="project-link" href={href} target="_blank" rel="noopener">
        <span class="visually-hidden">{title}</span>
        <span class="project-name scramble" data-scramble-trigger="reveal" aria-hidden="true"><span class="scramble-seg" data-text={title}>{title}</span></span>
      </a>
    </h3>
    <p class="project-text">{text}</p>
  </div>
  <div class="project-meta">
    <dl class="project-specs">
      {specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
    {extra && <a class="link project-extra" href={extra.href} target="_blank" rel="noopener">{extra.label}<Icon name="external" /></a>}
  </div>
  <span class="project-arrow" aria-hidden="true"><Icon name="external" /></span>
</li>
